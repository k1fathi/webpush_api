    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Authenticate and get JWT token"
                    },
                    "response": []
                },
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"new_user\",\n  \"email\": \"user@example.com\",\n  \"password\": \"securepassword\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        },
                        "description": "Register a new user"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Push Notifications",
            "item": [
                {
                    "name": "Send Push Notification",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"message\": \"This is a test notification\",\n  \"title\": \"Test Notification\",\n  \"icon\": \"https://example.com/icon.png\",\n  \"user_ids\": [\"user123\", \"user456\"],\n  \"data\": {\n    \"url\": \"https://example.com/details\"\n  }\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/send-push",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "send-push"
                            ]
                        },
                        "description": "Send push notification to specified users"
                    },
                    "response": []
                },
                {
                    "name": "Broadcast Notification",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"message\": \"Broadcast notification for all users\",\n  \"title\": \"Broadcast Alert\",\n  \"icon\": \"https://example.com/broadcast-icon.png\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/broadcast-push",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "broadcast-push"
                            ]
                        },
                        "description": "Send push notification to all subscribed users"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Subscriptions",
            "item": [
                {
                    "name": "Create Subscription",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"subscription\": {\n    \"endpoint\": \"https://fcm.googleapis.com/fcm/send/example-token\",\n    \"keys\": {\n      \"auth\": \"auth-key-example\",\n      \"p256dh\": \"p256dh-key-example\"\n    }\n  },\n  \"user_id\": \"{{user_id}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/subscriptions",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "subscriptions"
                            ]
                        },
                        "description": "Create a new push subscription for a user"
                    },
                    "response": []
                },
                {
                    "name": "Get User Subscriptions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/users/{{user_id}}/subscriptions",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "users",
                                "{{user_id}}",
                                "subscriptions"
                            ]
                        },
                        "description": "Get all subscriptions for a specific user"
                    },
                    "response": []
                },
                {
                    "name": "Delete Subscription",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/subscriptions/{{subscription_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "subscriptions",
                                "{{subscription_id}}"
                            ]
                        },
                        "description": "Delete a specific subscription"
                    },
                    "response": []
                }
            ]
        },
